<script>
/* =========================================================
   PERFORMANCE / UTILITIES
========================================================= */

const reduced =
  window.matchMedia("(prefers-reduced-motion: reduce)").matches;

const coarse =
  window.matchMedia("(pointer:coarse)").matches;


/* =========================================================
   LOADER
========================================================= */

const loader = document.getElementById("loader");
const loaderProgress = document.getElementById("loaderProgress");
const loaderPct = document.getElementById("loaderPct");

let progress = 0;

function loaderTick(){

  progress += Math.random() * 16 + 8;

  if(progress >= 100){
    progress = 100;
  }

  loaderProgress.style.width = progress + "%";
  loaderPct.textContent =
    String(Math.floor(progress)).padStart(2,"0") + "%";

  if(progress < 100){
    requestAnimationFrame(loaderTick);
  }else{
    setTimeout(()=>{
      loader.classList.add("hide");
      revealHero();
    },350);
  }
}

function revealHero(){

  document
    .querySelectorAll(".hero .reveal")
    .forEach((el,i)=>{
      setTimeout(()=>{
        el.classList.add("show");
      },i*120);
    });

  document
    .getElementById("heroTitle")
    .animate(
      [
        {opacity:0,transform:"translateY(50px)"},
        {opacity:1,transform:"translateY(0)"}
      ],
      {
        duration:1100,
        easing:"cubic-bezier(.16,1,.3,1)",
        fill:"forwards"
      }
    );
}

if(document.readyState === "complete"){
  setTimeout(loaderTick,200);
}else{
  window.addEventListener("load",()=>{
    setTimeout(loaderTick,200);
  });
}


/* =========================================================
   CURSOR
========================================================= */

if(!coarse){

  const cursor = document.getElementById("cursor");
  const ring = document.getElementById("cursorRing");

  let x=innerWidth/2;
  let y=innerHeight/2;

  let rx=x;
  let ry=y;

  window.addEventListener("mousemove",e=>{
    x=e.clientX;
    y=e.clientY;

    cursor.style.left=x+"px";
    cursor.style.top=y+"px";
  });

  function cursorLoop(){

    rx += (x-rx)*.16;
    ry += (y-ry)*.16;

    ring.style.left=rx+"px";
    ring.style.top=ry+"px";

    requestAnimationFrame(cursorLoop);
  }

  cursorLoop();

  document
    .querySelectorAll("a,button,.skill")
    .forEach(el=>{

      el.addEventListener("mouseenter",()=>{
        ring.classList.add("active");
      });

      el.addEventListener("mouseleave",()=>{
        ring.classList.remove("active");
      });

    });
}


/* =========================================================
   REVEALS
========================================================= */

const revealObserver =
  new IntersectionObserver(
    entries=>{
      entries.forEach(entry=>{
        if(entry.isIntersecting){
          entry.target.classList.add("show");
          revealObserver.unobserve(entry.target);
        }
      });
    },
    {
      threshold:.12,
      rootMargin:"0px 0px -50px"
    }
  );

document
  .querySelectorAll(".reveal")
  .forEach(el=>revealObserver.observe(el));


/* =========================================================
   STATEMENT WORD REVEAL
========================================================= */

const statement =
  document.getElementById("statementText");

const originalText = statement.innerHTML;

statement.innerHTML =
  originalText
    .split(/(\s+)/)
    .map(part=>{
      if(/\s+/.test(part)) return part;
      return `<span>${part}</span>`;
    })
    .join("");

const statementObserver =
  new IntersectionObserver(
    entries=>{
      if(entries[0].isIntersecting){

        statement
          .querySelectorAll("span")
          .forEach((span,i)=>{
            setTimeout(()=>{
              span.classList.add("visible");
            },i*130);
          });

        statementObserver.disconnect();
      }
    },
    {threshold:.3}
  );

statementObserver.observe(statement);


/* =========================================================
   CORE PARALLAX
========================================================= */

const core =
  document.getElementById("core");

if(!coarse && !reduced){

  let targetX=0;
  let targetY=0;
  let currentX=0;
  let currentY=0;

  window.addEventListener("mousemove",e=>{

    targetX =
      (e.clientX / innerWidth - .5) * 14;

    targetY =
      (e.clientY / innerHeight - .5) * 10;

  });

  function coreLoop(){

    currentX += (targetX-currentX)*.04;
    currentY += (targetY-currentY)*.04;

    core.style.marginLeft =
      currentX + "px";

    core.style.marginTop =
      currentY + "px";

    requestAnimationFrame(coreLoop);
  }

  coreLoop();
}


/* =========================================================
   SKILL INTERACTION
========================================================= */

document
  .querySelectorAll(".skill")
  .forEach(skill=>{

    skill.addEventListener("mouseenter",()=>{
      skill.style.paddingLeft="18px";
      skill.style.paddingRight="18px";
    });

    skill.addEventListener("mouseleave",()=>{
      skill.style.paddingLeft="";
      skill.style.paddingRight="";
    });

  });


/* =========================================================
   AGE + BIRTHDAY
========================================================= */

function updateBirthday(){

  const now = new Date();

  let year = now.getFullYear();

  let birthday =
    new Date(year,2,1,0,0,0);

  if(birthday <= now){
    birthday =
      new Date(year+1,2,1,0,0,0);
  }

  const diff =
    birthday.getTime()-now.getTime();

  const days =
    Math.floor(diff/86400000);

  const hours =
    Math.floor(
      (diff%86400000)/3600000
    );

  const minutes =
    Math.floor(
      (diff%3600000)/60000
    );

  const seconds =
    Math.floor(
      (diff%60000)/1000
    );

  document.getElementById("days").textContent =
    days;

  document.getElementById("hours").textContent =
    String(hours).padStart(2,"0");

  document.getElementById("minutes").textContent =
    String(minutes).padStart(2,"0");

  document.getElementById("seconds").textContent =
    String(seconds).padStart(2,"0");


  /*
    Birthday: March 1, 2007
  */

  const birth =
    new Date(2007,2,1);

  let age =
    now.getFullYear()-birth.getFullYear();

  const birthdayPassed =
    now.getMonth()>2 ||
    (
      now.getMonth()===2 &&
      now.getDate()>=1
    );

  if(!birthdayPassed) age--;

  document.getElementById("heroAge").textContent =
    age;

  document.getElementById("ageData").textContent =
    age+" YEARS OLD";
}

updateBirthday();

setInterval(updateBirthday,1000);


/* =========================================================
   BACK TO TOP
========================================================= */

document
  .getElementById("topBtn")
  .addEventListener("click",()=>{

    window.scrollTo({
      top:0,
      behavior:reduced ? "auto" : "smooth"
    });

  });


/* =========================================================
   SMALL SCROLL MOTION
   One passive listener only.
========================================================= */

if(!reduced){

  let ticking=false;

  window.addEventListener(
    "scroll",
    ()=>{

      if(ticking) return;

      ticking=true;

      requestAnimationFrame(()=>{

        const scroll =
          window.scrollY;

        const hero =
          document.getElementById("hero");

        if(scroll < innerHeight){

          const amount =
            scroll*.035;

          core.style.transform =
            `translateY(calc(-50% + ${amount}px))`;

        }

        ticking=false;

      });

    },
    {passive:true}
  );
}


/* =========================================================
   LANGUAGE SYSTEM
========================================================= */

const translations = {

  en:{
    title:"ASHRAF — Digital Identity"
  },

  ar:{
    title:"أشرف — هوية رقمية"
  }

};

function setLanguage(lang){

  document.documentElement.lang=lang;

  document.documentElement.dir =
    lang==="ar" ? "rtl" : "ltr";

  document.getElementById("enBtn")
    .classList.toggle("active",lang==="en");

  document.getElementById("arBtn")
    .classList.toggle("active",lang==="ar");

  document.title =
    translations[lang].title;

  try{
    localStorage.setItem(
      "ashraf-language",
      lang
    );
  }catch(e){}
}

document
  .getElementById("enBtn")
  .addEventListener("click",()=>{
    setLanguage("en");
  });

document
  .getElementById("arBtn")
  .addEventListener("click",()=>{
    setLanguage("ar");
  });

try{

  const saved =
    localStorage.getItem("ashraf-language");

  if(saved==="ar"){
    setLanguage("ar");
  }

}catch(e){}


/* =========================================================
   VISIBILITY PERFORMANCE
========================================================= */

document.addEventListener(
  "visibilitychange",
  ()=>{
    if(document.hidden){
      document.documentElement.style
        .setProperty("--animation-state","paused");
    }
  }
);

</script>

