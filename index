<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>ASHRAF — Digital Identity</title>
<meta name="description" content="ASHRAF — Developer, Programmer, Digital Builder. Quiet life. Refined taste. Bigger goals.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Mono:wght@400;500&family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">

<style>
:root{
  --black:#050505;
  --black2:#090909;
  --white:#eee9e6;
  --muted:#77716e;
  --red:#d92731;
  --red2:#7d0b10;
  --line:rgba(255,255,255,.09);
  --display:"Space Grotesk",sans-serif;
  --mono:"DM Mono",monospace;
  --arabic:"Cairo",sans-serif;
}

*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
html,body{background:var(--black);color:var(--white);overflow-x:hidden}
body{font-family:var(--display);cursor:none}
a{color:inherit;text-decoration:none}
button{font:inherit;border:0;background:none;color:inherit}
img{display:block;max-width:100%}

@media (pointer:coarse){
  body{cursor:auto}
}

::selection{
  background:var(--red);
  color:white;
}

/* =========================================================
   GLOBAL
========================================================= */

.wrap{
  width:min(1400px,100%);
  margin:auto;
  padding-inline:clamp(20px,5vw,72px);
}

section{
  position:relative;
}

.mono{
  font-family:var(--mono);
  font-size:10px;
  letter-spacing:.16em;
  color:var(--muted);
  text-transform:uppercase;
}

.line{
  width:100%;
  height:1px;
  background:var(--line);
}

.red{
  color:var(--red);
}

[dir="rtl"] body{
  font-family:var(--arabic);
}

[dir="rtl"] .mono{
  font-family:var(--arabic);
  letter-spacing:0;
}

/* =========================================================
   CURSOR
========================================================= */

.cursor{
  position:fixed;
  width:7px;
  height:7px;
  border-radius:50%;
  background:white;
  pointer-events:none;
  z-index:9999;
  transform:translate(-50%,-50%);
  mix-blend-mode:difference;
}

.cursor-ring{
  position:fixed;
  width:34px;
  height:34px;
  border:1px solid rgba(255,255,255,.4);
  border-radius:50%;
  pointer-events:none;
  z-index:9998;
  transform:translate(-50%,-50%);
  transition:
    width .35s cubic-bezier(.16,1,.3,1),
    height .35s cubic-bezier(.16,1,.3,1),
    border-color .35s ease;
}

.cursor-ring.active{
  width:74px;
  height:74px;
  border-color:var(--red);
}

@media(pointer:coarse){
  .cursor,.cursor-ring{display:none}
}

/* =========================================================
   LOADER
========================================================= */

.loader{
  position:fixed;
  inset:0;
  z-index:10000;
  background:#050505;
  display:flex;
  align-items:flex-end;
  justify-content:space-between;
  padding:clamp(24px,5vw,70px);
  transition:
    opacity .8s ease,
    visibility .8s ease;
}

.loader.hide{
  opacity:0;
  visibility:hidden;
}

.loader-name{
  font-size:clamp(48px,12vw,150px);
  font-weight:700;
  letter-spacing:-.06em;
  line-height:.8;
}

.loader-meta{
  font-family:var(--mono);
  font-size:10px;
  color:var(--muted);
  letter-spacing:.15em;
}

.loader-progress{
  position:absolute;
  left:0;
  bottom:0;
  height:2px;
  width:0;
  background:var(--red);
}

/* =========================================================
   NAV
========================================================= */

.nav{
  position:fixed;
  top:0;
  left:0;
  right:0;
  z-index:500;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:
    calc(22px + env(safe-area-inset-top))
    clamp(20px,5vw,72px)
    22px;
  mix-blend-mode:difference;
}

.nav-logo{
  font-size:14px;
  font-weight:600;
  letter-spacing:.16em;
}

.lang{
  display:flex;
  align-items:center;
  gap:10px;
  font-family:var(--mono);
  font-size:10px;
  letter-spacing:.12em;
}

.lang button{
  color:#777;
  cursor:none;
}

.lang button.active{
  color:white;
}

@media(pointer:coarse){
  .lang button{cursor:pointer}
}

/* =========================================================
   HERO
========================================================= */

.hero{
  min-height:100svh;
  display:flex;
  align-items:center;
  overflow:hidden;
  background:
    radial-gradient(
      circle at 72% 48%,
      rgba(125,11,16,.22),
      transparent 30%
    ),
    #050505;
}

.hero-grid{
  position:absolute;
  inset:0;
  opacity:.18;
  background-image:
    linear-gradient(rgba(255,255,255,.045) 1px,transparent 1px),
    linear-gradient(90deg,rgba(255,255,255,.045) 1px,transparent 1px);
  background-size:80px 80px;
  mask-image:linear-gradient(to bottom,black,transparent);
}

.hero-orbit{
  position:absolute;
  width:min(60vw,760px);
  aspect-ratio:1;
  right:-5%;
  top:50%;
  transform:translateY(-50%);
  border:1px solid rgba(217,39,49,.22);
  border-radius:50%;
  box-shadow:
    0 0 100px rgba(125,11,16,.08),
    inset 0 0 100px rgba(125,11,16,.04);
}

.hero-orbit::before,
.hero-orbit::after{
  content:"";
  position:absolute;
  inset:12%;
  border:1px solid rgba(255,255,255,.07);
  border-radius:50%;
}

.hero-orbit::after{
  inset:30%;
  border-color:rgba(217,39,49,.14);
}

.hero-content{
  position:relative;
  z-index:5;
  width:100%;
  padding-top:80px;
}

.hero-index{
  margin-bottom:28px;
}

.hero-title{
  font-size:clamp(76px,17vw,250px);
  line-height:.76;
  letter-spacing:-.075em;
  font-weight:700;
  position:relative;
  z-index:3;
}

.hero-title .ghost{
  color:transparent;
  -webkit-text-stroke:1px rgba(238,233,230,.45);
}

.hero-title .red{
  color:var(--red);
}

.hero-bottom{
  margin-top:50px;
  display:flex;
  justify-content:space-between;
  align-items:flex-end;
  gap:30px;
}

.hero-description{
  max-width:420px;
  color:#aaa3a0;
  font-size:15px;
  line-height:1.7;
}

.hero-role{
  font-family:var(--mono);
  font-size:10px;
  color:var(--muted);
  letter-spacing:.13em;
  margin-bottom:10px;
}

.hero-coordinates{
  font-family:var(--mono);
  font-size:9px;
  line-height:2;
  color:var(--muted);
  text-align:right;
}

.hero-scroll{
  position:absolute;
  bottom:28px;
  left:50%;
  transform:translateX(-50%);
  display:flex;
  align-items:center;
  gap:12px;
  font-family:var(--mono);
  font-size:9px;
  letter-spacing:.2em;
  color:var(--muted);
}

.hero-scroll span:last-child{
  width:45px;
  height:1px;
  background:linear-gradient(90deg,var(--muted),transparent);
}

/* central 3D object */

.core{
  position:absolute;
  right:17%;
  top:50%;
  width:min(27vw,370px);
  aspect-ratio:1;
  transform:translateY(-50%);
  z-index:2;
  perspective:1000px;
}

.core-sphere{
  position:absolute;
  inset:17%;
  border-radius:50%;
  background:
    radial-gradient(
      circle at 32% 28%,
      #454545 0%,
      #151515 28%,
      #080808 65%,
      #020202 100%
    );
  box-shadow:
    -25px -20px 60px rgba(255,255,255,.08),
    25px 30px 90px rgba(217,39,49,.12),
    inset -20px -20px 40px rgba(0,0,0,.9);
  animation:floatCore 7s ease-in-out infinite;
}

.core-sphere::after{
  content:"";
  position:absolute;
  inset:12%;
  border-radius:50%;
  border:1px solid rgba(255,255,255,.12);
}

.core-ring{
  position:absolute;
  inset:0;
  border:1px solid rgba(217,39,49,.65);
  border-radius:50%;
  transform:rotateX(68deg) rotateZ(18deg);
  animation:orbit 12s linear infinite;
}

.core-ring:nth-child(3){
  inset:7%;
  border-color:rgba(255,255,255,.17);
  transform:rotateY(70deg) rotateZ(-22deg);
  animation-duration:18s;
  animation-direction:reverse;
}

.core-ring:nth-child(4){
  inset:23%;
  border-color:rgba(217,39,49,.18);
  transform:rotateX(75deg) rotateY(30deg);
  animation-duration:8s;
}

.core-point{
  position:absolute;
  width:7px;
  height:7px;
  background:var(--red);
  border-radius:50%;
  top:7%;
  left:50%;
  box-shadow:0 0 20px var(--red);
}

@keyframes orbit{
  to{transform:rotateX(68deg) rotateZ(378deg)}
}

@keyframes floatCore{
  0%,100%{transform:translateY(0)}
  50%{transform:translateY(-18px)}
}

@media(max-width:900px){
  .hero-orbit{
    width:100vw;
    right:-45%;
  }

  .core{
    width:250px;
    right:3%;
    top:38%;
    opacity:.7;
  }

  .hero-title{
    font-size:clamp(70px,19vw,150px);
  }

  .hero-bottom{
    flex-direction:column;
    align-items:flex-start;
  }

  .hero-coordinates{
    text-align:left;
  }
}

/* =========================================================
   INTRO STATEMENT
========================================================= */

.statement{
  min-height:85svh;
  display:flex;
  align-items:center;
  background:#080808;
  overflow:hidden;
}

.statement::before{
  content:"ASHRAF";
  position:absolute;
  right:-8vw;
  top:50%;
  transform:translateY(-50%) rotate(-90deg);
  font-size:clamp(100px,20vw,300px);
  font-weight:700;
  color:transparent;
  -webkit-text-stroke:1px rgba(255,255,255,.035);
  pointer-events:none;
}

.statement-inner{
  position:relative;
  z-index:2;
}

.statement-label{
  margin-bottom:50px;
}

.statement-text{
  max-width:1050px;
  font-size:clamp(38px,7.2vw,105px);
  line-height:1;
  letter-spacing:-.055em;
  font-weight:500;
}

.statement-text span{
  color:#55504e;
  transition:color .5s ease;
}

.statement-text span.visible{
  color:var(--white);
}

.statement-bottom{
  display:flex;
  justify-content:space-between;
  margin-top:70px;
  gap:30px;
}

.statement-bottom p{
  max-width:380px;
  color:var(--muted);
  line-height:1.7;
  font-size:14px;
}

/* =========================================================
   IDENTITY
========================================================= */

.identity{
  padding:170px 0;
  background:#050505;
}

.identity-head{
  display:grid;
  grid-template-columns:.35fr 1fr;
  gap:50px;
  margin-bottom:100px;
}

.identity-title{
  font-size:clamp(50px,9vw,130px);
  line-height:.86;
  letter-spacing:-.06em;
  font-weight:600;
}

.identity-title .outline{
  color:transparent;
  -webkit-text-stroke:1px #777;
}

.identity-layout{
  display:grid;
  grid-template-columns:1fr .8fr;
  gap:100px;
  align-items:end;
}

.identity-copy{
  max-width:650px;
}

.identity-copy p{
  font-size:clamp(20px,2.4vw,32px);
  line-height:1.35;
  color:#c9c3c0;
  letter-spacing:-.025em;
}

.signature{
  margin-top:65px;
  font-family:var(--arabic);
  font-size:clamp(35px,5vw,65px);
  display:inline-block;
  color:white;
}

.identity-data{
  border-top:1px solid var(--line);
}

.data-row{
  display:flex;
  justify-content:space-between;
  gap:20px;
  padding:18px 0;
  border-bottom:1px solid var(--line);
  font-family:var(--mono);
  font-size:10px;
}

.data-row span:first-child{
  color:var(--muted);
}

.data-row span:last-child{
  text-align:right;
}

.birth{
  margin-top:50px;
}

.birth-title{
  margin-bottom:20px;
}

.countdown{
  display:flex;
  gap:22px;
}

.count-number{
  font-size:clamp(28px,4vw,48px);
  font-weight:500;
  letter-spacing:-.04em;
}

.count-label{
  display:block;
  margin-top:4px;
  font-family:var(--mono);
  color:var(--muted);
  font-size:8px;
  letter-spacing:.13em;
}

@media(max-width:850px){
  .identity-head,
  .identity-layout{
    grid-template-columns:1fr;
  }

  .identity-layout{
    gap:60px;
  }
}

/* =========================================================
   STACK
========================================================= */

.stack{
  padding:160px 0;
  background:#090909;
}

.stack-header{
  display:flex;
  justify-content:space-between;
  align-items:flex-end;
  margin-bottom:80px;
}

.stack-title{
  font-size:clamp(60px,10vw,150px);
  letter-spacing:-.07em;
  line-height:.8;
}

.stack-title small{
  display:block;
  font-family:var(--mono);
  font-size:10px;
  color:var(--muted);
  letter-spacing:.16em;
  margin-bottom:20px;
}

.skill{
  position:relative;
  border-top:1px solid var(--line);
  padding:27px 0;
  display:grid;
  grid-template-columns:80px 1fr auto;
  align-items:center;
  gap:25px;
  overflow:hidden;
  cursor:none;
}

.skill:last-child{
  border-bottom:1px solid var(--line);
}

.skill-number{
  font-family:var(--mono);
  color:var(--muted);
  font-size:10px;
}

.skill-name{
  font-size:clamp(30px,5vw,65px);
  letter-spacing:-.045em;
  transition:transform .5s cubic-bezier(.16,1,.3,1);
}

.skill-meta{
  font-family:var(--mono);
  color:var(--muted);
  font-size:9px;
  text-align:right;
}

.skill-fill{
  position:absolute;
  left:0;
  bottom:0;
  width:0;
  height:2px;
  background:var(--red);
  transition:width .7s cubic-bezier(.16,1,.3,1);
}

.skill:hover .skill-fill{
  width:100%;
}

.skill:hover .skill-name{
  transform:translateX(18px);
}

[dir="rtl"] .skill:hover .skill-name{
  transform:translateX(-18px);
}

@media(max-width:650px){
  .skill{
    grid-template-columns:45px 1fr;
  }

  .skill-meta{
    grid-column:2;
    text-align:left;
  }
}

/* =========================================================
   BUSINESS WORLD
========================================================= */

.business{
  min-height:100svh;
  display:flex;
  align-items:center;
  background:
    radial-gradient(
      circle at 80% 50%,
      rgba(217,39,49,.1),
      transparent 32%
    ),
    #050505;
  overflow:hidden;
}

.business-ring{
  position:absolute;
  right:-10%;
  width:65vw;
  max-width:900px;
  aspect-ratio:1;
  border-radius:50%;
  border:1px solid rgba(255,255,255,.06);
}

.business-ring::before,
.business-ring::after{
  content:"";
  position:absolute;
  border-radius:50%;
  border:1px solid rgba(217,39,49,.13);
}

.business-ring::before{inset:15%}
.business-ring::after{inset:35%}

.business-content{
  position:relative;
  z-index:2;
  width:100%;
}

.business-small{
  margin-bottom:35px;
}

.business-title{
  font-size:clamp(65px,11vw,165px);
  line-height:.82;
  letter-spacing:-.07em;
}

.business-title .thin{
  font-weight:400;
  color:#68615e;
}

.business-copy{
  max-width:440px;
  margin-top:45px;
  margin-left:25%;
  color:var(--muted);
  line-height:1.7;
}

.business-tags{
  display:flex;
  gap:10px;
  margin-top:40px;
  flex-wrap:wrap;
}

.business-tag{
  border:1px solid var(--line);
  padding:12px 18px;
  font-family:var(--mono);
  font-size:9px;
  letter-spacing:.12em;
}

/* =========================================================
   JOURNEY
========================================================= */

.journey{
  padding:170px 0;
  background:#090909;
}

.journey-intro{
  display:flex;
  justify-content:space-between;
  align-items:flex-end;
  margin-bottom:100px;
}

.journey-title{
  font-size:clamp(65px,10vw,150px);
  line-height:.82;
  letter-spacing:-.07em;
}

.journey-description{
  max-width:320px;
  color:var(--muted);
  font-size:14px;
  line-height:1.7;
}

.journey-list{
  border-top:1px solid var(--line);
}

.journey-item{
  display:grid;
  grid-template-columns:80px 1fr 1fr;
  padding:35px 0;
  border-bottom:1px solid var(--line);
  align-items:center;
  transition:padding .5s ease;
}

.journey-item:hover{
  padding-left:20px;
  padding-right:20px;
  background:rgba(255,255,255,.015);
}

.journey-num{
  font-family:var(--mono);
  font-size:10px;
  color:var(--red);
}

.journey-name{
  font-size:clamp(28px,4vw,55px);
  letter-spacing:-.04em;
}

.journey-text{
  color:var(--muted);
  font-size:13px;
}

@media(max-width:700px){
  .journey-intro{
    display:block;
  }

  .journey-description{
    margin-top:30px;
  }

  .journey-item{
    grid-template-columns:45px 1fr;
    gap:15px;
  }

  .journey-text{
    grid-column:2;
  }
}

/* =========================================================
   SOCIAL
========================================================= */

.social{
  padding:160px 0;
  background:#050505;
}

.social-heading{
  font-size:clamp(65px,11vw,155px);
  letter-spacing:-.075em;
  line-height:.8;
  margin-bottom:90px;
}

.social-heading .outline{
  color:transparent;
  -webkit-text-stroke:1px rgba(238,233,230,.5);
}

.social-grid{
  display:grid;
  grid-template-columns:repeat(5,1fr);
  border-top:1px solid var(--line);
  border-left:1px solid var(--line);
}

.social-link{
  min-height:230px;
  padding:24px;
  border-right:1px solid var(--line);
  border-bottom:1px solid var(--line);
  position:relative;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
  overflow:hidden;
  transition:background .4s ease;
}

.social-link::before{
  content:"";
  position:absolute;
  width:180px;
  height:180px;
  border-radius:50%;
  background:var(--red);
  filter:blur(70px);
  opacity:0;
  right:-100px;
  bottom:-100px;
  transition:opacity .5s ease;
}

.social-link:hover{
  background:#0c0c0c;
}

.social-link:hover::before{
  opacity:.22;
}

.social-platform{
  font-family:var(--mono);
  font-size:9px;
  color:var(--muted);
  letter-spacing:.15em;
}

.social-handle{
  position:relative;
  font-size:17px;
  z-index:2;
}

.social-arrow{
  position:relative;
  z-index:2;
  align-self:flex-end;
  font-size:25px;
}

@media(max-width:900px){
  .social-grid{
    grid-template-columns:repeat(2,1fr);
  }
}

@media(max-width:550px){
  .social-grid{
    grid-template-columns:1fr;
  }
}

/* =========================================================
   CONTACT
========================================================= */

.contact{
  min-height:90svh;
  display:flex;
  align-items:center;
  background:#090909;
}

.contact-label{
  margin-bottom:45px;
}

.contact-title{
  font-size:clamp(65px,11vw,160px);
  line-height:.8;
  letter-spacing:-.075em;
}

.contact-title .outline{
  color:transparent;
  -webkit-text-stroke:1px rgba(238,233,230,.5);
}

.contact-copy{
  margin-top:50px;
  max-width:420px;
  color:var(--muted);
  line-height:1.7;
}

.contact-actions{
  margin-top:40px;
  display:flex;
  gap:12px;
}

.contact-button{
  border:1px solid rgba(255,255,255,.2);
  padding:17px 28px;
  font-family:var(--mono);
  font-size:9px;
  letter-spacing:.15em;
  transition:
    background .3s ease,
    color .3s ease,
    border-color .3s ease;
}

.contact-button.primary{
  background:white;
  color:#050505;
}

.contact-button:hover{
  background:var(--red);
  border-color:var(--red);
  color:white;
}

/* =========================================================
   FINALE
========================================================= */

.finale{
  height:100svh;
  min-height:600px;
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
  background:#030303;
}

.finale-core{
  position:absolute;
  width:min(70vw,850px);
  aspect-ratio:1;
  border:1px solid rgba(217,39,49,.18);
  border-radius:50%;
  animation:finaleRotate 25s linear infinite;
}

.finale-core::before,
.finale-core::after{
  content:"";
  position:absolute;
  inset:12%;
